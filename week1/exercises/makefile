CC?=gcc
CFLAGS?=-std=c11 -Wall -Werror -Wextra -pedantic

mynameis: mynameis.c
	$(CC) -o mynameis mynameis.c $(CFLAGS)

repeatme: repeatme.c
	$(CC) -o repeatme repeatme.c $(CFLAGS)

foo: foo.c
	$(CC) -o foo foo.c $(CFLAGS)

noAs: noAs.c
	$(CC) -o noAs noAs.c $(CFLAGS)

bing: bing.c
	$(CC) -o bing bing.c $(CFLAGS)